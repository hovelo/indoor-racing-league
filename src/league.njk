---
layout: base.njk
private: true
pagination:
  data: standings.leagues
  size: 1
  alias: league
  addAllPagesToCollections: false
permalink: "/l/{{ league.slug }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ league.name }}"
  homeHref: "/l/{{ league.slug }}/"
---
{%- from "macros.njk" import eventNum, typeBadge, statusBadge, place, routeName, dates, clubLogo, stravaClubButton -%}
{%- set feature = league.current or league.next %}
<section class="hero">
	<div class="wrap hero-inner">
		<div class="hero-main">
			{%- if league.club %}
			<p class="hero-club">{{ clubLogo(league.club, 'lg') }}<span><span class="kicker">{{ league.club.name }}</span><span class="hero-club-platform">{{ league.platform | capitalize }}</span></span></p>
			{%- else %}
			<p class="kicker">{{ league.platform | capitalize }}</p>
			{%- endif %}
			<h1 class="display">{{ league.name }}</h1>
			<ul class="hero-stats">
				<li><strong>{{ league.riders }}</strong> riders</li>
				<li><strong>{{ league.eventsDone }}/{{ league.eventColumns | length }}</strong> events</li>
			</ul>
			{%- if league.club and league.club.strava %}
			<p class="hero-actions">{{ stravaClubButton(league.club) }}</p>
			{%- endif %}
		</div>
		{%- if feature %}
		<a class="feature-card" href="/l/{{ league.slug }}/{{ feature.id }}/">
			<span class="feature-top">
				<span class="label">{% if feature.status == 'open' %}Riding now{% else %}Next up{% endif %}</span>
				<span class="mono">{% if feature.status == 'open' %}{{ feature.daysLeft }} day{% if feature.daysLeft != 1 %}s{% endif %} left{% else %}Opens {{ feature.window.from | shortDate }}{% endif %}</span>
			</span>
			<span class="feature-title">{% if feature.type == 'qualifier' %}Qualifier{% else %}Event {{ eventNum(feature) }}{% endif %} · {{ routeName(feature) }}</span>
			<span class="feature-meta">{% if feature.type == 'qualifier' %}Qualifier{% else %}{{ feature.route_type | capitalize }}{% endif %} · {{ dates(feature) }} · ride it solo, flat out</span>
			<span class="feature-link">Event details <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
		</a>
		{%- endif %}
	</div>
</section>

<div class="wrap">
	<section class="section">
		<div class="section-head">
			<h2>Standings</h2>
			{%- if league.lastClosed %}
			<p class="section-note">Points after Event {{ eventNum(league.lastClosed) }}</p>
			{%- endif %}
		</div>
		{%- if league.table | length %}
		<div class="panel table-scroll">
			<table class="table">
				<thead>
					<tr>
						<th class="col-place" scope="col">Pos</th>
						<th scope="col">Rider</th>
						<th class="num" scope="col"><abbr title="Qualifier">Q</abbr></th>
						{%- for e in league.eventColumns %}
						<th class="num" scope="col"><a href="/l/{{ league.slug }}/{{ e.id }}/" title="{{ e.route.name }}">E{{ e.number }}</a></th>
						{%- endfor %}
						<th class="num col-total" scope="col">Total</th>
					</tr>
				</thead>
				<tbody>
					{%- for row in league.table %}
					<tr{% if row.place == 1 %} class="is-leader"{% endif %}>
						<td class="col-place">{{ place(row) }}</td>
						<td class="rider">{{ row.display }}{% if not row.qualifier %} <span class="tag">No qualifier</span>{% endif %}</td>
						<td class="num">{% if row.qualifier %}{{ row.qualifier }}{% else %}<span class="dim">&ndash;</span>{% endif %}</td>
						{%- for pts in row.events %}
						<td class="num">{% if pts !== null %}{{ pts }}{% else %}<span class="dim">&ndash;</span>{% endif %}</td>
						{%- endfor %}
						<td class="num total">{{ row.total }}</td>
					</tr>
					{%- endfor %}
				</tbody>
			</table>
		</div>
		{%- else %}
		<p class="empty">No results yet. Ride the qualifier!</p>
		{%- endif %}
	</section>

	<section class="section">
		<div class="section-head">
			<h2>Events</h2>
		</div>
		<ol class="events">
			{%- for e in league.events %}
			<li>
				<a class="event-row is-{{ e.status }}" href="/l/{{ league.slug }}/{{ e.id }}/">
					<span class="event-num">{{ eventNum(e) }}</span>
					<span class="event-title">
						<span class="event-route">{{ routeName(e) }}</span>
						{%- if e.route.world %}<span class="event-world">{{ e.route.world }}{% if e.route.distance_km %} · {{ e.route.distance_km }} km{% endif %}{% if e.route.elevation_m %} · {{ e.route.elevation_m }} m{% endif %}</span>{% endif %}
					</span>
					<span class="event-tags">
						{{ typeBadge(e) }}
						<span class="event-dates mono">{{ dates(e) }}</span>
						{{ statusBadge(e) }}
					</span>
				</a>
			</li>
			{%- endfor %}
		</ol>
	</section>

	{%- set rules = league.rules %}
	{%- set pts = rules.points %}
	{%- set words = ['none', 'fastest rider', 'two fastest riders', 'three fastest riders', 'four fastest riders', 'five fastest riders'] %}
	{%- set bonusCount = rules.segmentBonus | length %}
	<section class="section" id="rules">
		<div class="section-head">
			<h2>Rules</h2>
			<p class="section-note">How this league is set up</p>
		</div>
		<div class="points">
			<div class="points-card panel">
				<h3>Events</h3>
				<ul class="points-list">
					<li><span class="points-value">{{ pts.first }}</span><span>for the best result against prediction{% if pts.step > 0 %}, then {{ pts.step }} fewer per place{% if rules.floorPlace and rules.floorPlace > 1 %}, down to {{ pts.min }} from {{ rules.floorPlace | ordinal }} place{% endif %}{% endif %}</span></li>
					{%- if pts.participation %}
					<li><span class="points-value">+{{ pts.participation }}</span><span>for every finish, so everyone who rides scores</span></li>
					{%- endif %}
					{%- if bonusCount %}
					<li><span class="points-value">+{{ rules.segmentBonus | join('/') }}</span><span>to the {{ words[bonusCount] if bonusCount < words | length else bonusCount + ' fastest riders' }} on each bonus segment, on raw times, when an event has them</span></li>
					{%- endif %}
				</ul>
			</div>
			<div class="points-card panel">
				<h3>Qualifier</h3>
				<ul class="points-list">
					{%- if pts.participation %}
					<li><span class="points-value">+{{ pts.participation }}</span><span>for riding it</span></li>
					{%- endif %}
					{%- if bonusCount %}
					<li><span class="points-value">+{{ rules.segmentBonus | join('/') }}</span><span>to the {{ words[bonusCount] if bonusCount < words | length else bonusCount + ' fastest riders' }} on each climb and sprint</span></li>
					{%- endif %}
					<li><span class="points-value">&ndash;</span><span>no finishing points: it sets everyone's predicted times</span></li>
				</ul>
			</div>
		</div>
		<dl class="league-rules panel">
			{%- if league.club %}
			<div><dt>Club</dt><dd>{% if league.club.strava %}Join <a href="{{ league.club.strava }}" rel="noopener">{{ league.club.name }} on Strava</a> and keep your Strava sync on. Results come from the club leaderboard, so rides only count if you're in the club and they aren't set to &ldquo;Only You&rdquo;.{% else %}{{ league.club.name }}.{% endif %}</dd></div>
			{%- endif %}
			{%- if rules.qualifier %}
			<div><dt>Qualifier</dt><dd><a href="/l/{{ league.slug }}/{{ rules.qualifier.id }}/">{{ rules.qualifier.route.name }}</a>{% if rules.qualifier.route.world %}, {{ rules.qualifier.route.world }}{% endif %}. Ride it as often as you like in the window; your best effort on each segment counts.</dd></div>
			{%- endif %}
			{%- if rules.targetMinutes %}
			<div><dt>Event length</dt><dd>Routes take about {{ rules.targetMinutes | join('&ndash;') | safe }} minutes at 2.5&ndash;3 W/kg, each open for two weeks.</dd></div>
			{%- endif %}
			<div><dt>Dropped results</dt><dd>{% if rules.dropWorst %}Your worst {% if rules.dropWorst == 1 %}event score doesn't{% else %}{{ rules.dropWorst }} event scores don't{% endif %} count. Missed events are dropped first; the qualifier is never dropped.{% else %}None: every event counts.{% endif %}</dd></div>
			<div><dt>Ties</dt><dd>Riders level to the second share the higher place and its points.</dd></div>
			<div><dt>No qualifier yet?</dt><dd>You can still ride events{% if pts.participation %} and score {{ pts.participation }} for finishing{% endif %}{% if bonusCount %}, plus any segment bonus{% endif %}. Ride the qualifier route to get ranked.</dd></div>
		</dl>
	</section>
</div>
