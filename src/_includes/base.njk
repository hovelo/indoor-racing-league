<!doctype html>
<html lang="en-GB">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
	{%- if private %}
	<meta name="robots" content="noindex, nofollow">
	<meta name="referrer" content="no-referrer">
	{%- else %}
	<meta name="description" content="Close racing, whatever your level. A ride-when-you-like indoor cycling league for groups of friends, scored on your time against your predicted time.">
	{%- endif %}
	<meta name="theme-color" content="#14171c">
	<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
	<link rel="preload" href="/fonts/barlow-condensed-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="/css/style.css">
</head>
<body>
	{%- from "macros.njk" import clubLogo -%}
	{#- League and event pages belong to a club; the public homepage never shows one. -#}
	{%- set pageClub = clubPage or null %}
	{%- if private %}{% set pageClub = league.club if league else (event.league.club if event else null) %}{% endif %}
	<header class="site-header">
		<div class="wrap site-header-inner">
			<a class="brand" href="{% if private %}{{ homeHref or '/' }}{% else %}/{% endif %}">
				<span class="brand-mark" aria-hidden="true">IRL</span>
				<span class="brand-name{% if pageClub %} hide-xs{% endif %}">{{ site.name }}</span>
			</a>
			{%- if pageClub %}
			<a class="header-club" href="{{ pageClub.page }}">
				{{ clubLogo(pageClub, 'sm') }}
				<span class="header-club-name">{{ pageClub.name }}</span>
			</a>
			{%- else %}
			<a class="button button-ghost" href="/#join">Start a league</a>
			{%- endif %}
		</div>
	</header>

	<main>
		{{ content | safe }}
	</main>

	<footer class="site-footer">
		<div class="wrap site-footer-inner">
			{%- if pageClub %}
			<p>{% if clubPage %}{{ pageClub.name }}{% else %}A league for <a href="{{ pageClub.page }}">{{ pageClub.name }}</a>{% endif %}{% if pageClub.url %} · <a href="{{ pageClub.url }}" rel="noopener">{{ pageClub.url | domain }}</a>{% endif %}{% if pageClub.strava %} · <a href="{{ pageClub.strava }}" rel="noopener">Strava club</a>{% endif %}</p>
			{%- endif %}
			<p>Made by <a href="https://www.mikestreety.co.uk/">Mike Street</a>.</p>
			{%- if standings.usingSample %}
			<p>Built from sample data.</p>
			{%- endif %}
		</div>
	</footer>
</body>
</html>
