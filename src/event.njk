---
layout: base.njk
private: true
pagination:
  data: standings.events
  size: 1
  alias: event
  addAllPagesToCollections: false
permalink: "/l/{{ event.league.slug }}/{{ event.id }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ event.label }}: {{ event.route.name }}"
  homeHref: "/l/{{ event.league.slug }}/"
---
{%- from "macros.njk" import typeBadge, statusBadge, place, routeName, dates, clubLogo, stravaClubButton -%}
{%- set hasSegments = event.segments | length %}
{%- set ranked = event.results | length %}
{%- set riders = ranked + (event.unbenchmarked | length) %}
<section class="hero hero-event">
	<div class="wrap">
		<a class="back" href="/l/{{ event.league.slug }}/"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{{ event.league.name }}</a>
		<div class="hero-inner">
			<div class="hero-main">
				<p class="event-badges">
					<span class="event-kicker">{{ event.label }}</span>
					{% if event.type != 'qualifier' %}{{ typeBadge(event) }}{% endif %}
					{{ statusBadge(event) }}
				</p>
				<h1 class="display">{{ routeName(event) }}</h1>
			</div>
			<dl class="facts">
				<div><dt>Window</dt><dd>{{ dates(event) }}</dd></div>
				{%- if event.laps and event.laps > 1 %}<div><dt>Laps</dt><dd>{{ event.laps }}, fastest counts</dd></div>{% endif %}
				{%- if event.route.world %}<div><dt>World</dt><dd>{{ event.route.world }}</dd></div>{% endif %}
				{%- if event.route.distance_km %}<div><dt>Distance</dt><dd>{{ event.route.distance_km }} km{% if event.laps and event.laps > 1 %}/lap{% endif %}</dd></div>{% endif %}
				{%- if event.route.elevation_m %}<div><dt>Elevation</dt><dd>{{ event.route.elevation_m }} m{% if event.laps and event.laps > 1 %}/lap{% endif %}</dd></div>{% endif %}
			</dl>
		</div>
		<div class="hero-foot">
			<span>
				{%- if event.type == 'qualifier' %}{{ riders }} rider{% if riders != 1 %}s{% endif %}
				{%- else %}{{ riders }} rider{% if riders != 1 %}s{% endif %} · {{ ranked }} ranked{% if event.weights %} · weights: climb {{ event.weights.climb | percent }}, flat {{ event.weights.flat | percent }}, sprint {{ event.weights.sprint | percent }}{% endif %}{% endif -%}
			</span>
			{%- if (event.route.info and event.route.info.url) or (event.scoreSegment and event.scoreSegment.url) %}
			<span class="hero-links">
				{%- if event.scoreSegment and event.scoreSegment.url %}
				<a href="{{ event.scoreSegment.url }}" rel="noopener">{{ event.scoreSegment.name }} on Strava</a>
				{%- endif %}
				{%- if event.route.info and event.route.info.url %}
				<a href="{{ event.route.info.url }}" rel="noopener">Route map and profile on {{ event.route.info.name or 'the route guide' }}</a>
				{%- endif %}
			</span>
			{%- endif %}
		</div>
	</div>
</section>

<div class="wrap">
	{%- set club = event.league.club %}
	{%- if club and club.strava and event.status != 'closed' %}
	<div class="club-strip panel">
		{{ clubLogo(club, 'md') }}
		<p>Rides count once they're on the <strong>{{ club.name }}</strong> Strava leaderboard. Make sure you're in the club and your ride isn't set to &ldquo;Only You&rdquo;.</p>
		{{ stravaClubButton(club) }}
	</div>
	{%- endif %}

	{%- if event.notes %}
	<p class="notice">{{ event.notes }}</p>
	{%- endif %}

	{%- if not riders %}
	<section class="section">
		<p class="empty">{% if event.status == 'upcoming' %}Opens {{ event.window.from | shortDate }}. Get your legs ready.{% elif event.status == 'open' %}Open until {{ event.window.to | shortDate }}. No results in yet.{% else %}No results.{% endif %}</p>
	</section>

	{%- elif event.type == 'qualifier' %}
	<section class="section">
		<div class="section-head">
			<h2>Riders</h2>
			<p class="section-note">{{ event.participation }} points for riding, plus segment bonuses in the window · late riders get {{ event.participation }} only</p>
		</div>
		<div class="panel table-scroll">
			<table class="table">
				<thead>
					<tr><th scope="col">Rider</th><th class="num" scope="col">Bonus</th><th class="num col-total" scope="col">Points</th></tr>
				</thead>
				<tbody>
					{%- for r in event.results %}
					<tr>
						<td class="rider">{{ r.display }}{% if r.late %} <span class="tag">Late</span>{% endif %}</td>
						<td class="num">{% if r.bonus %}+{{ r.bonus }}{% else %}<span class="dim">&ndash;</span>{% endif %}</td>
						<td class="num total">{{ r.points }}</td>
					</tr>
					{%- endfor %}
				</tbody>
			</table>
		</div>
	</section>

	{%- else %}
	{%- if event.status == 'open' %}
	<p class="notice">The window is still open, so these results are provisional.</p>
	{%- endif %}

	{%- if ranked %}
	<section class="podium" aria-label="Podium">
		{%- for r in event.results | batch(3) | first %}
		<div class="podium-card{% if loop.first %} is-first{% endif %}">
			<div class="podium-top">
				<span class="podium-place">{% if r.tied %}={% endif %}{{ r.place }}</span>
				<span class="mono">+{{ r.points }} pts</span>
			</div>
			<div class="podium-name">{{ r.display }}</div>
		</div>
		{%- endfor %}
	</section>
	{%- endif %}

	<section class="section">
		<div class="section-head">
			<h2>Results</h2>
			<p class="section-note">Ranked on time against each rider's prediction · times aren't published{% if event.scoreSegment and event.scoreSegment.url %}; ride times are on <a href="{{ event.scoreSegment.url }}" rel="noopener">Strava</a>{% endif %}</p>
		</div>
		<div class="panel table-scroll">
			{%- if ranked %}
			<table class="table">
				<thead>
					<tr>
						<th class="col-place" scope="col">Pos</th>
						<th scope="col">Rider</th>
						<th class="num hide-sm" scope="col">Place</th>
						<th class="num hide-sm" scope="col">Finish</th>
						{%- if hasSegments %}<th class="num hide-sm" scope="col">Bonus</th>{% endif %}
						<th class="num col-total" scope="col">Points</th>
					</tr>
				</thead>
				<tbody>
					{%- for r in event.results %}
					<tr>
						<td class="col-place">{{ place(r) }}</td>
						<td class="rider">{{ r.display }}</td>
						<td class="num hide-sm">{{ r.finishPoints }}</td>
						<td class="num hide-sm">{{ event.participation }}</td>
						{%- if hasSegments %}<td class="num hide-sm">{% if r.bonus %}{{ r.bonus }}{% else %}<span class="dim">&ndash;</span>{% endif %}</td>{% endif %}
						<td class="num total">{{ r.points }}</td>
					</tr>
					{%- endfor %}
				</tbody>
			</table>
			{%- endif %}
			{%- if event.unbenchmarked | length %}
			<div class="unbenchmarked">
				<span class="label">Unbenchmarked</span>
				<ul>
					{%- for r in event.unbenchmarked %}
					<li><strong>{{ r.display }}</strong> <span class="mono">{{ r.points }}</span></li>
					{%- endfor %}
				</ul>
				<p class="muted">Finished, but not ranked until their qualifier takes effect{% if hasSegments and event.segments[0].mode == 'handicap' %}, so no segment bonus either{% endif %}.</p>
			</div>
			{%- endif %}
		</div>
	</section>
	{%- endif %}

	{%- if hasSegments %}
	<section class="section">
		<div class="section-head">
			<h2>Bonus segments</h2>
			<p class="section-note">{% if event.segments[0].mode == 'handicap' %}Ranked against each rider's own benchmark for the segment, so ranked riders only · {% elif event.type != 'qualifier' %}Fastest raw times · {% endif %}segment names link to Strava, where you can see ride times (filter the leaderboard to the club)</p>
		</div>
		<div class="segments">
			{%- for seg in event.segments %}
			<div class="panel segment">
				<div class="segment-head">
					<h3>{% if seg.url %}<a href="{{ seg.url }}" rel="noopener">{{ seg.name }} <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>{% else %}{{ seg.name }}{% endif %}</h3>
					{%- if seg.type == 'climb' or seg.type == 'sprint' %}<span class="badge badge-seg-{{ seg.type }}">{{ seg.type }}</span>{% endif %}
				</div>
				{%- if seg.results | length %}
				<ol class="segment-list">
					{%- for r in seg.results %}
					{%- if r.points %}
					<li>
						<span class="segment-place">{% if r.tied %}={% endif %}{{ r.place }}</span>
						<span class="segment-rider">{{ r.display }}</span>
						<span class="mono">+{{ r.points }}</span>
					</li>
					{%- endif %}
					{%- endfor %}
				</ol>
				{%- else %}
				<p class="empty">No efforts yet.</p>
				{%- endif %}
			</div>
			{%- endfor %}
		</div>
	</section>
	{%- endif %}

	{%- if event.type != 'qualifier' and ranked %}
	<section class="section explainer">
		<div>
			<h3>How it's ranked</h3>
			<p>Your time on the road is adjusted by your handicap for a {{ event.route_type }} route, and riders are ranked on that. Beat your own prediction by the most and you win, however fast you are. Only places and points are shown.</p>
		</div>
		{%- if event.benchmarksUpdated %}
		<div>
			<h3>Benchmarks moved</h3>
			<p>Everyone who rode had their benchmark nudged towards how they rode this one, ready for the next event{% for seg in event.segments %}{% if seg.benchmarksUpdated %}{% if loop.first %}. Bonus segments also tightened the matching climb or sprint benchmark{% endif %}{% endif %}{% endfor %}.</p>
		</div>
		{%- endif %}
	</section>
	{%- endif %}
</div>
